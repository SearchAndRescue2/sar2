<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 0.94.1 -->
<interface>
  <!-- interface-name editormenugtk4.ui -->
  <requires lib="gtk" version="4.10"/>
  <object class="GtkWindow" id="window">
    <property name="opacity">0.75</property>
    <property name="title">Scenery editor</property>
    <child>
      <object class="GtkGrid" id="grid">
        <property name="column-homogeneous">True</property>
        <property name="row-homogeneous">True</property>
        <property name="tooltip-text" translatable="yes">Unload the current object
(let the triedron alone)</property>
        <child>
          <object class="GtkLabel" id="label">
            <property name="label">Scenery modifications are not yet be printed.
Do you want to print them before quit?</property>
            <property name="margin-bottom">6</property>
            <property name="margin-end">6</property>
            <property name="margin-start">6</property>
            <property name="margin-top">6</property>
            <property name="use-markup">True</property>
            <layout>
              <property name="column">0</property>
              <property name="column-span">2</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button_yes">
            <property name="has-tooltip">True</property>
            <property name="label">Yes</property>
            <property name="margin-bottom">6</property>
            <property name="margin-end">3</property>
            <property name="margin-start">6</property>
            <property name="margin-top">6</property>
            <property name="name">obj_closer</property>
            <property name="tooltip-text">Modify the closer object</property>
            <layout>
              <property name="column">0</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button_no">
            <property name="label">No</property>
            <property name="margin-bottom">6</property>
            <property name="margin-end">3</property>
            <property name="margin-start">3</property>
            <property name="margin-top">6</property>
            <property name="name">obj_current</property>
            <layout>
              <property name="column">1</property>
              <property name="row">1</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
