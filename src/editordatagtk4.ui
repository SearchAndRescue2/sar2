                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Growing rate (m/s)</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">3</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Hide at max altitude (m)</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">4</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Respawn interval (ms)</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">5</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Number of clouds</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">6</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Color code</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">7</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="smoke_radius_start">
                            <property name="focusable">1</property>
                            <property name="input-purpose">number</property>
                            <property name="text">0.5</property>
                            <property name="width-chars">10</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="smoke_radius_max">
                            <property name="focusable">1</property>
                            <property name="input-purpose">number</property>
                            <property name="text">10.0</property>
                            <property name="width-chars">10</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="smoke_radius_rate">
                            <property name="focusable">1</property>
                            <property name="input-purpose">number</property>
                            <property name="text">0.2</property>
                            <property name="width-chars">10</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">3</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="smoke_hide_at_max">
                            <property name="focusable">1</property>
                            <property name="input-purpose">number</property>
                            <property name="text">100.0</property>
                            <property name="width-chars">10</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">4</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="smoke_respawn_int">
                            <property name="focusable">1</property>
                            <property name="input-purpose">digits</property>
                            <property name="text">500</property>
                            <property name="width-chars">10</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">5</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="smoke_total_units">
                            <property name="focusable">1</property>
                            <property name="input-purpose">digits</property>
                            <property name="text">25</property>
                            <property name="width-chars">10</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">6</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkDropDown" id="smoke_color_code">
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item translatable="yes">0</item>
                                  <item translatable="yes">1</item>
                                  <item translatable="yes">2</item>
                                  <item translatable="yes">3</item>
                                </items>
                              </object>
                            </property>
                            <property name="tooltip-markup" translatable="yes">&lt;b&gt;0&lt;/b&gt; : grey / white
&lt;b&gt;1&lt;/b&gt; : medium grey
&lt;b&gt;2&lt;/b&gt; : dark / black
&lt;b&gt;3&lt;/b&gt; : orange</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">7</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="hexpand">1</property>
                    <property name="label-xalign">0.05</property>
                    <property name="margin-bottom">5</property>
                    <property name="margin-end">10</property>
                    <property name="margin-start">10</property>
                    <property name="margin-top">5</property>
                    <child type="label">
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Smoke specific data</property>
                        <property name="margin-bottom">5</property>
                        <property name="margin-end">10</property>
                        <property name="margin-start">10</property>
                        <property name="margin-top">5</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="buttons_box">
                    <property name="halign">center</property>
                    <property name="margin-bottom">5</property>
                    <child>
                      <object class="GtkButton" id="button_ok">
                        <property name="focusable">1</property>
                        <property name="label">Ok</property>
                        <property name="margin-bottom">5</property>
                        <property name="margin-end">5</property>
                        <property name="margin-start">5</property>
                        <property name="margin-top">5</property>
                        <property name="receives-default">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="button_apply">
                        <property name="focusable">1</property>
                        <property name="label">Apply</property>
                        <property name="margin-bottom">5</property>
                        <property name="margin-end">5</property>
                        <property name="margin-start">5</property>
                        <property name="margin-top">5</property>
                        <property name="receives-default">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="button_cancel">
                        <property name="focusable">1</property>
                        <property name="label">Cancel</property>
                        <property name="margin-bottom">5</property>
                        <property name="margin-end">5</property>
                        <property name="margin-start">5</property>
                        <property name="margin-top">5</property>
                        <property name="receives-default">1</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
        <property name="propagate-natural-height">1</property>
      </object>
    </property>
    <property name="default-height">230</property>
    <property name="default-width">450</property>
    <property name="title">Scenery editor</property>
    <property name="visible">1</property>
  </object>
</interface>
