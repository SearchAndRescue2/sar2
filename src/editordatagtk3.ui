<interface>
  <!-- interface-name editorgtk3.ui -->
  <requires lib="gtk+" version="3.0"/>
  <object class="GtkWindow" id="window">
    <property name="can-focus">False</property>
    <property name="default-height">230</property>
    <property name="default-width">450</property>
    <property name="title">Scenery editor</property>
    <property name="visible">True</property>
    <child>
      <object class="GtkScrolledWindow" id="scrolled_window">
        <property name="can-focus">False</property>
        <property name="propagate-natural-height">True</property>
        <property name="visible">True</property>
        <property name="window-placement-set">False</property>
        <child>
          <object class="GtkViewport">
            <property name="can-focus">False</property>
            <property name="visible">True</property>
            <child>
              <object class="GtkBox" id="main_box">
                <property name="baseline-position">top</property>
                <property name="can-focus">False</property>
                <property name="halign">center</property>
                <property name="orientation">vertical</property>
                <property name="valign">start</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkFrame" id="general_frame">
                    <property name="can-focus">False</property>
                    <property name="hexpand">True</property>
                    <property name="label-xalign">0.05000000074505806</property>
                    <property name="margin-bottom">5</property>
                    <property name="margin-end">10</property>
                    <property name="margin-start">10</property>
                    <property name="margin-top">5</property>
                    <property name="shadow-type">out</property>
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkGrid" id="general_frame_grid">
                        <property name="can-focus">False</property>
                        <property name="column-spacing">6</property>
                        <property name="margin-bottom">10</property>
                        <property name="margin-end">5</property>
                        <property name="margin-start">5</property>
                        <property name="visible">True</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="can-focus">False</property>
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Type</property>
                            <property name="visible">True</property>
                          </object>
                          <packing>
                            <property name="left-attach">0</property>
                            <property name="top-attach">0</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkLabel" id="general_object_name_label">
                            <property name="can-focus">False</property>
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Object name</property>
                            <property name="name">general_data</property>
                            <property name="visible">True</property>
                          </object>
                          <packing>
                            <property name="left-attach">0</property>
                            <property name="top-attach">1</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkLabel" id="general_pos_label">
                            <property name="can-focus">False</property>
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Position (m|m|ft)</property>
                            <property name="name">general_data</property>
                            <property name="visible">True</property>
                          </object>
                          <packing>
                            <property name="left-attach">0</property>
                            <property name="top-attach">2</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkLabel" id="general_dir_label">
                            <property name="can-focus">False</property>
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Direction (deg)</property>
                            <property name="name">general_data</property>
                            <property name="visible">True</property>
                          </object>
                          <packing>
                            <property name="left-attach">0</property>
                            <property name="top-attach">3</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkEntry" id="general_object_name">
                            <property name="can-focus">True</property>
                            <property name="input-purpose">alpha</property>
                            <property name="name">general_data</property>
                            <property name="tooltip-text" translatable="yes">This name can be used as a reference name for this object.
Leave it blank to use the model name value (if any).
No space characters are allowed.</property>
                            <property name="visible">True</property>
                          </object>
                          <packing>
                            <property name="left-attach">1</property>
                            <property name="top-attach">1</property>
                            <property name="width">3</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkEntry" id="general_pos_x">
                            <property name="can-focus">True</property>
                            <property name="input-purpose">number</property>
                            <property name="name">general_data</property>
                            <property name="placeholder-text" translatable="yes">x</property>
                            <property name="text">0.0</property>
                            <property name="visible">True</property>
                            <property name="width-chars">10</property>
                          </object>
                          <packing>
                            <property name="left-attach">1</property>
                            <property name="top-attach">2</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkEntry" id="general_pos_y">
                            <property name="can-focus">True</property>
                            <property name="input-purpose">number</property>
                            <property name="name">general_data</property>
                            <property name="placeholder-text" translatable="yes">y</property>
                            <property name="text">0.0</property>
                            <property name="visible">True</property>
                            <property name="width-chars">10</property>
                          </object>
                          <packing>
                            <property name="left-attach">2</property>
                            <property name="top-attach">2</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkEntry" id="general_pos_z">
                            <property name="can-focus">True</property>
                            <property name="input-purpose">number</property>
                            <property name="name">general_data</property>
                            <property name="placeholder-text" translatable="yes">z</property>
                            <property name="text">0.0</property>
                            <property name="visible">True</property>
                            <property name="width-chars">10</property>
                          </object>
                          <packing>
                            <property name="left-attach">3</property>
                            <property name="top-attach">2</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkEntry" id="general_dir_heading">
                            <property name="can-focus">True</property>
                            <property name="input-purpose">number</property>
                            <property name="name">general_data</property>
                            <property name="placeholder-text" translatable="yes">heading</property>
                            <property name="text">0.0</property>
                            <property name="visible">True</property>
                            <property name="width-chars">10</property>
                          </object>
                          <packing>
                            <property name="left-attach">1</property>
                            <property name="top-attach">3</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkEntry" id="general_dir_pitch">
                            <property name="can-focus">True</property>
                            <property name="input-purpose">number</property>
                            <property name="name">general_data</property>
                            <property name="placeholder-text" translatable="yes">pitch</property>
                            <property name="text">0.0</property>
                            <property name="visible">True</property>
                            <property name="width-chars">10</property>
                          </object>
                          <packing>
                            <property name="left-attach">2</property>
                            <property name="top-attach">3</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkEntry" id="general_dir_bank">
                            <property name="can-focus">True</property>
                            <property name="input-purpose">number</property>
                            <property name="name">general_data</property>
                            <property name="placeholder-text" translatable="yes">bank</property>
                            <property name="text">0.0</property>
                            <property name="visible">True</property>
                            <property name="width-chars">10</property>
                          </object>
                          <packing>
                            <property name="left-attach">3</property>
                            <property name="top-attach">3</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkComboBoxText" id="general_type">
                            <property name="can-focus">False</property>
                            <property name="tooltip-markup">&lt;b&gt;Automobile&lt;/b&gt; : an automobile model defined in a SarII *.3d file.
&lt;b&gt;Fire&lt;/b&gt; : a parametric fire animation.
&lt;b&gt;Helipad&lt;/b&gt; : a parametric helicopter landing and takeoff area.
&lt;b&gt;Human&lt;/b&gt; : a parametric animated human.
&lt;b&gt;Premodeled&lt;/b&gt; : a parametric building, a parametric control tower,
			or a parametric steel lattice power transmission
			tower, radio tower or generic tower.
&lt;b&gt;Smoke&lt;/b&gt; : a parametric smoke animation.
&lt;b&gt;Static&lt;/b&gt; : Any non-parametric static model defined in a SarII *.3d file.
&lt;b&gt;Runway&lt;/b&gt; : a parametric aircraft landing and takeoff area.
&lt;b&gt;Watercraft&lt;/b&gt; : a watercraft model defined in a SarII *.3d file.</property>
                            <property name="tooltip-text" translatable="yes">Choose an object type</property>
                            <property name="visible">True</property>
                            <items>
                              <item>Automobile</item>
                              <item>Fire</item>
                              <item>Helipad</item>
                              <item>Human</item>
                              <item>Premodeled</item>
                              <item>Smoke</item>
                              <item>Static</item>
                              <item>Runway</item>
                              <item>Watercraft</item>
                            </items>
                          </object>
                          <packing>
                            <property name="left-attach">1</property>
                            <property name="top-attach">0</property>
                            <property name="width">3</property>
                          </packing>
                        </child>
                      </object>
                    </child>
                    <child type="label">
                      <object class="GtkLabel">
                        <property name="can-focus">False</property>
                        <property name="label" translatable="yes">Object general data</property>
                        <property name="margin-bottom">5</property>
                        <property name="margin-end">10</property>
                        <property name="margin-start">10</property>
                        <property name="margin-top">5</property>
                        <property name="visible">True</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkFrame" id="fire_frame">
                    <property name="can-focus">False</property>
                    <property name="hexpand">True</property>
